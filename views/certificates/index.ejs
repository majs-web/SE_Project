<!DOCTYPE html>
<html lang="en">
    <%- include('../includes/login-head', {title: 'Register | Webproject'}) %>
<body>
    <%- include('../includes/login-header') %>

  <article>
    <div class="article">
      <div class="container">
        <h2>My certificates</h2>
        <ul class="news-list">
          <% certificates.forEach(certificate => { %>
            <li>
              <% if(certificate.isInStock) { %> 
                <h4><%= certificate.name %>: <%= certificate.description %></h4>
                <a class="secondary" href="/certificates/<%= certificate.slug %>">Read more</a>
              <% } else { %>
                <%= certificate.name %> [NOT FOUND] 
              <% } %>
            </li>
          <% }) %>
        </ul>
        <a class="cta-button" href="/certificates/new">Register new certficate</a><br/>
        <a class="login-button" href="/profile">Back</a>
      </div>
    </div>
  </article>

    <%- include('../includes/footer') %>
</body>
</html>