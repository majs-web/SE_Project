<!DOCTYPE html>
<html lang="en">
    <%- include('../includes/head', {title: `${certificate.name} | Webproject`}) %>
<body>
    <%- include('../includes/header') %>

    <main>
        <h2><%= certificate.name %></h2>
        <p><em><%= new Date(certificate.date).toLocaleDateString() %></em></p>
        <p><%= certificate.description %></p>
        <button><a href="/certificates/<%= certificate.slug %>/edit">Edit</a></button><br />
                <button><a href="/certificates/<%= certificate.slug %>/delete">Delete</a></button><br />
        <button><a href="/profile">Back</a></button>
    </main>

    <%- include('../includes/footer') %>
</body>
</html>