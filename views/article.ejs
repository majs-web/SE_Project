<!DOCTYPE html>
<html lang="en">
    <%- include('includes/head', {title: 'Home'}) %>
<body>
    <%- include('includes/header') %>

    <article>
        <div class="article">
            <div class="container">
                <h2><%= article.title %></h2>
                <p><em><%= new Date(article.date).toLocaleDateString() %></em></p>
                <p><%= article.body %></p>
            </div>
            <div class="link">
                <p><a class="login-button" href="/news">Back to all news</a></p>
            </div>
        </div>
    </article>
    
    <%- include('includes/footer') %>
</body>
</html>