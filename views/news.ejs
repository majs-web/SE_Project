<!DOCTYPE html>
<html lang="en">
<%- include('includes/head', {title: 'Home'}) %>
<body>
    <header>
        <%- include('includes/header') %>
    </header>

    <main>
        <ul class="news-list">
            <h2>Our current articles</h2>
            <% articles.forEach(article => { %>
                <li>
                    <h3><a href="/news/<%= article.slug %>"><%= article.title %></a></h3>
                    <p><em><%= new Date(article.date).toLocaleDateString() %></em></p>
                    <p><% article.summary %></p>
                    <a href="/news/<%= article.slug %>">Read more -></a>
                </li>
            <% }) %>
        </ul>
    </main>

    <footer>
        <%- include('includes/footer') %>
    </footer>
</body>
</html>