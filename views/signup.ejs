<!DOCTYPE html>
<html lang="en">
    <%- include('includes/login-head.ejs', {title: 'Home'}) %>
<body>

    <% if (typeof errorr !== 'undefined') { %>
    <p style="color:red"><%= error %></p>
    <% } %>

    <form method="POST" action="/signup">
        <input name="username" placeholder="Username" required />
        <input name="password" placeholder="Password" type="password">
        <button href="/profile">Sign Up</button>
    </form>

    <p>Already have a profile?</p><a href="/login">Login</a>

    <%- include('includes/footer') %>
</body>
</html>